cabal-version:      3.14
name:               liminal
version:            0.1.0.0
synopsis:           General-purpose fuzzy logic library with mood assessment application
description:
    Liminal provides membership functions, fuzzy operators, t-norms/s-norms,
    Mamdani and Sugeno inference, and defuzzification. The mood application
    maps daily self-report inputs onto the circumplex model of affect.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Real Limoges
maintainer:         b.real.limoges@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall -O2

library
    import:           warnings
    exposed-modules:
        Liminal
        Liminal.Core.Types
        Liminal.Core.TNorm
        Liminal.Core.Operators
        Liminal.Core.Membership
        Liminal.Core.Defuzzify
        Liminal.Inference.Types
        Liminal.Inference.Mamdani
        Liminal.Inference.Sugeno
        Liminal.Inference.Evaluate
        Liminal.Mood.Variables
        Liminal.Mood.Rules
        Liminal.Mood.Gaps
        Liminal.Mood.Assessment
    build-depends:
        base ^>=4.21.0.0,
        text,
        containers,
        vector
    hs-source-dirs:   src
    default-language: GHC2024

executable liminal
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        liminal,
        servant,
        servant-server,
        warp,
        aeson,
        text,
        containers
    hs-source-dirs:   app
    default-language: GHC2024

test-suite liminal-test
    import:           warnings
    default-language: GHC2024
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Liminal.Core.TNormSpec
        Liminal.Core.OperatorsSpec
        Liminal.Core.MembershipSpec
        Liminal.Core.DefuzzifySpec
        Liminal.Inference.EvaluateSpec
    build-depends:
        base ^>=4.21.0.0,
        liminal,
        hspec,
        QuickCheck,
        text,
        containers
    build-tool-depends:
        hspec-discover:hspec-discover
